---
import Base from "../../layouts/Base.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import SectionHead from "../../components/SectionHead.astro";
import Gallery from "../../components/Gallery.astro";
import CtaBand from "../../components/CtaBand.astro";
import Deco from "../../components/Deco.astro";
import Wave from "../../components/Wave.astro";

const lang = "en" as const;
const trail = [
  { name: "Home", href: "/en/" },
  { name: "Gallery", href: "/en/gallery" },
];
---

<Base
  title="Gallery of Children's Parties in the Algarve — Ted Animações"
  description="Photos from birthday parties and children's entertainment in the Algarve: treasure hunts, face painting, bracelet workshops and group games at real parties."
  lang={lang}
  path="/en/gallery"
  breadcrumbs={trail}
>
  <Breadcrumbs trail={trail} lang={lang} />

  <section class="section bg-cream" style="padding-top:2.5rem">
    <Deco shape="wiggle" color="#2D7A6E" class="animate-float-slow" style="width:220px;top:6%;right:2%;opacity:.4" />

    <div class="container">
      <SectionHead
        eyebrow="Real moments"
        title='Party <span class="text-teal">gallery</span>'
        lede="Every photo is from a party I ran in the Algarve. None of it is stock imagery."
        as="h1"
      />
      <div style="margin-top:3rem"><Gallery lang={lang} /></div>
    </div>
    <Wave fill="#F0E4C4" variant={1} />
  </section>

  <CtaBand lang={lang} context="a birthday party" />
</Base>
