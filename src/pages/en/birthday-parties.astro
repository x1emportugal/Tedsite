---
import { Image } from "astro:assets";
import Base from "../../layouts/Base.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import SectionHead from "../../components/SectionHead.astro";
import ActivityCard from "../../components/ActivityCard.astro";
import Reviews from "../../components/Reviews.astro";
import FaqList from "../../components/FaqList.astro";
import TrustStrip from "../../components/TrustStrip.astro";
import CtaBand from "../../components/CtaBand.astro";
import Icon from "../../components/Icon.astro";
import Deco from "../../components/Deco.astro";
import Wave from "../../components/Wave.astro";
import { photo } from "../../lib/images";
import { whatsappUrl, SERVICE_AREAS } from "../../lib/site";
import { getActivities, getFaqs, getReviews, ratingForSchema, DEMO_REVIEWS } from "../../lib/content";
import { serviceSchema, faqSchema } from "../../lib/schema";

const lang = "en" as const;
const activities = await getActivities(lang);
const faqs = await getFaqs(lang, "home");
const reviews = await getReviews(lang, true);
const rating = ratingForSchema(reviews);

const path = "/en/birthday-parties";
const trail = [
  { name: "Home", href: "/en/" },
  { name: "Birthday parties", href: path },
];

const timeline = [
  { time: "Before", title: "We plan it together", desc: "Ages, group size, space and time. I prepare the programme and send a fixed quote." },
  { time: "-30 min", title: "I arrive and set up", desc: "Early enough to set everything up without getting in the way of arriving guests." },
  { time: "1st hour", title: "Ice-breakers and games", desc: "High energy first: group games that get children talking to each other." },
  { time: "2nd hour", title: "Main activity", desc: "Treasure hunt or craft workshop, whichever we agreed. This is the part they remember." },
  { time: "End", title: "Wind down and cake", desc: "A calmer activity so the group is seated and settled by the time the cake appears." },
];
---

<Base
  title="Children's Birthday Parties in the Algarve | English-Speaking Entertainer"
  description="Birthday party entertainment for children in the Algarve, at villas, homes and hotels. Programme built around the ages and the space, all materials included, in English and Portuguese."
  lang={lang}
  path={path}
  breadcrumbs={trail}
  rating={rating}
  schemas={[
    serviceSchema({
      name: "Children's birthday party entertainment",
      description:
        "Full birthday party entertainment in the Algarve: group games, treasure hunts, face painting and craft workshops, with the programme built around the ages and the venue.",
      url: path,
    }),
    faqSchema(faqs),
  ]}
>
  <Breadcrumbs trail={trail} lang={lang} />

  <section class="section bg-cream" style="padding-top:2rem">
    <Deco shape="wiggle" color="#2D7A6E" class="animate-float-slow" style="width:300px;top:6%;right:-40px;opacity:.5" />

    <div class="container">
      <div class="split">
        <div>
          <p class="eyebrow mb-md">
            <Icon name="cake" size={14} color="#1A2E2A" /> Birthday parties
          </p>
          <h1 class="h1 mb-md">A party the children <span class="text-teal">don't forget</span></h1>
          <p class="lede mb-lg">
            I arrive with the programme ready, every material packed and the
            energy to keep a whole group going from start to finish. You only
            need to handle the cake.
          </p>
          <div class="row gap-md">
            <a href={whatsappUrl("a birthday party", lang)} class="btn btn-whatsapp btn-lg" target="_blank" rel="noopener" data-cta="parties-hero-en">
              <Icon name="whatsapp" size={22} />
              Check my date
            </a>
            <a href="/en/prices" class="btn btn-outline">See prices</a>
          </div>
        </div>

        <div class="blob-frame" style="aspect-ratio:4/3">
          <Image
            src={photo("criancas-em-roda.jpg")}
            alt="Children sitting in a circle at a birthday party in the Algarve"
            widths={[480, 760, 1100]}
            sizes="(min-width: 900px) 46vw, 92vw"
            loading="eager"
            fetchpriority="high"
          />
        </div>
      </div>
    </div>
    <Wave fill="#F0E4C4" variant={1} />
  </section>

  <section class="section bg-cream-deep">
    <div class="container">
      <SectionHead
        eyebrow="Start to finish"
        title="How a party runs, hour by hour"
        lede="Pace is the part that matters most and the part you notice when it goes wrong: high at the start, winding down to the cake."
        eyebrowTeal
      />
      <div class="timeline mt-lg">
        {timeline.map((s, i) => (
          <div class="timeline-row reveal" style={`transition-delay:${i * 80}ms`}>
            <div class="timeline-time">{s.time}</div>
            <div class="timeline-body">
              <h3 class="h3 mb-sm">{s.title}</h3>
              <p style="color:var(--ink-soft);font-size:.96rem">{s.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
    <Wave fill="#FAF0DC" variant={2} />
  </section>

  <section class="section bg-cream">
    <div class="container">
      <SectionHead eyebrow="What goes in" title="Activities to choose from" />
      <div class="grid grid-4 mt-lg">
        {activities.map((a, i) => <ActivityCard activity={a.data} lang={lang} delay={i * 90} />)}
      </div>
    </div>
    <Wave fill="#2D7A6E" variant={3} />
  </section>

  <section class="section bg-teal">
    <div class="container">
      <SectionHead eyebrow="Before booking" title="What parents want to know" dark />
      <div class="mt-lg"><TrustStrip lang={lang} /></div>
    </div>
    <Wave fill="#F0E4C4" variant={1} />
  </section>

  {reviews.length > 0 && (
    <section class="section bg-cream-deep">
      <div class="container">
        <SectionHead eyebrow="Algarve families" title="What parents say" />
        <div class="mt-lg"><Reviews reviews={reviews} lang={lang} showEmptyNotice={false} /></div>
      </div>
      <Wave fill="#FAF0DC" variant={2} />
    </section>
  )}

  <section class="section bg-cream">
    <div class="container-narrow">
      <SectionHead eyebrow="Frequently asked" title="Questions about the party" eyebrowTeal />
      <div class="mt-lg"><FaqList items={faqs} /></div>
      <p class="center mt-lg" style="color:var(--ink-muted);font-size:.95rem">
        I work in {SERVICE_AREAS.join(", ")} and the surrounding areas.
      </p>
    </div>
  </section>

  <CtaBand lang={lang} context="a birthday party" />
</Base>

<style>
  .timeline { display: grid; gap: 1rem; max-width: 780px; margin-inline: auto; }
  .timeline-row {
    display: grid;
    grid-template-columns: 88px 1fr;
    gap: 1.5rem;
    background: var(--white);
    border-radius: var(--r-md);
    padding: 1.4rem 1.6rem;
    box-shadow: var(--shadow-sm);
    align-items: start;
  }
  .timeline-time {
    font-family: var(--font-display), sans-serif;
    font-weight: 800;
    font-size: .88rem;
    color: var(--teal);
    background: var(--cream-deep);
    border-radius: 9999px;
    padding: .3rem .6rem;
    text-align: center;
  }
  @media (max-width: 600px) {
    .timeline-row { grid-template-columns: 1fr; gap: .7rem; }
    .timeline-time { justify-self: start; }
  }
</style>
