---
import { Image } from "astro:assets";
import Base from "../../layouts/Base.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import CtaBand from "../../components/CtaBand.astro";
import Deco from "../../components/Deco.astro";
import Wave from "../../components/Wave.astro";
import { photo } from "../../lib/images";

const lang = "en" as const;
const trail = [
  { name: "Home", href: "/en/" },
  { name: "About Ted", href: "/en/about" },
];
---

<Base
  title="About Ted | Children's Entertainer in the Algarve"
  description="Meet Ted, a bear from Brazil who loves to play and brings children's entertainment to parties, hotels and events in Portugal."
  lang={lang}
  path="/en/about"
  breadcrumbs={trail}
>
  <Breadcrumbs trail={trail} lang={lang} />

  <section class="section bg-cream" style="padding-top:2rem">
    <Deco shape="circle" color="#F5C842" size={70} class="animate-float-slow" style="top:12%;right:6%;opacity:.5" />

    <div class="container">
      <div class="split">
        <div class="blob-frame-alt" style="aspect-ratio:3/4;max-width:400px;margin-inline:auto">
          <Image
            src={photo("ted-com-criancas.jpg")}
            alt="Ted sitting and talking with a group of children at a party in the Algarve"
            widths={[360, 560, 800]}
            sizes="(min-width: 900px) 40vw, 90vw"
            loading="eager"
            fetchpriority="high"
          />
        </div>
        <div>
          <p class="eyebrow eyebrow-teal mb-md">About me</p>
          <h1 class="h1 mb-md">Hi, I'm <span class="text-teal">Ted</span></h1>
          <p class="lede">
            I'm a bear who loves to play. I came from Brazil to bring children's
            entertainment to Portugal. What's your favourite game?
          </p>
        </div>
      </div>
    </div>
    <Wave fill="#F0E4C4" variant={1} />
  </section>

  <CtaBand lang={lang} context="a birthday party" />
</Base>
