---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import CtaBand from "../components/CtaBand.astro";
import Deco from "../components/Deco.astro";
import Wave from "../components/Wave.astro";
import { photo } from "../lib/images";

const lang = "pt" as const;
const trail = [
  { name: "Início", href: "/" },
  { name: "Sobre o Ted", href: "/sobre-o-ted" },
];
---

<Base
  title="Sobre o Ted | Animador Infantil no Algarve"
  description="Conheça o Ted, um urso que veio do Brasil para brincar e fazer animação infantil em festas, hotéis e eventos em Portugal."
  lang={lang}
  path="/sobre-o-ted"
  breadcrumbs={trail}
>
  <Breadcrumbs trail={trail} lang={lang} />

  <section class="section bg-cream" style="padding-top:2rem">
    <Deco shape="circle" color="#F5C842" size={70} class="animate-float-slow" style="top:12%;right:6%;opacity:.5" />

    <div class="container">
      <div class="split">
        <div class="blob-frame-alt" style="aspect-ratio:3/4;max-width:400px;margin-inline:auto">
          <Image
            src={photo("ted-com-criancas.jpg")}
            alt="Ted sentado a conversar com um grupo de crianças durante uma festa no Algarve"
            widths={[360, 560, 800]}
            sizes="(min-width: 900px) 40vw, 90vw"
            loading="eager"
            fetchpriority="high"
          />
        </div>
        <div>
          <p class="eyebrow eyebrow-teal mb-md">Sobre mim</p>
          <h1 class="h1 mb-md">Olá, eu sou o <span class="text-teal">Ted</span></h1>
          <p class="lede">
            Sou um urso que gosta muito de brincar. Vim do Brasil para fazer
            animação em Portugal. Qual é a sua brincadeira favorita?
          </p>
        </div>
      </div>
    </div>
    <Wave fill="#F0E4C4" variant={1} />
  </section>

  <CtaBand lang={lang} context="uma festa de aniversário" />
</Base>
