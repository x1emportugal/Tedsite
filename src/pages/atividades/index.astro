---
import Base from "../../layouts/Base.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import SectionHead from "../../components/SectionHead.astro";
import ActivityCard from "../../components/ActivityCard.astro";
import CtaBand from "../../components/CtaBand.astro";
import Deco from "../../components/Deco.astro";
import Wave from "../../components/Wave.astro";
import { getActivities } from "../../lib/content";
import { Image } from "astro:assets";
import slimeImage from "../../assets/images/slime-roxo-decorado.png";
import { photo } from "../../lib/images";

const lang = "pt" as const;
const activities = await getActivities(lang);
const trail = [
  { name: "Início", href: "/" },
  { name: "Atividades", href: "/atividades" },
];
---

<Base
  title="Atividades para Festas Infantis no Algarve | Ted Animações"
  description="Caça ao tesouro, pintura facial, oficina de pulseiras e jogos de grupo para festas de aniversário no Algarve. Veja como funciona cada atividade, para que idades e quanto tempo demora."
  lang={lang}
  path="/atividades"
  breadcrumbs={trail}
>
  <Breadcrumbs trail={trail} lang={lang} />

  <section class="section bg-cream" style="padding-top:2.5rem">
    <Deco shape="circle" color="#F5C842" size={70} class="animate-float-med" style="top:12%;right:6%;opacity:.5" />
    <Deco shape="dots" color="#2D7A6E" style="width:90px;bottom:15%;left:4%;opacity:.3" />

    <div class="container">
      <SectionHead
        eyebrow="O repertório completo"
        title='Atividades para festas de <span class="text-teal">aniversário</span>'
        lede="Cada festa leva uma combinação diferente. Escolhemos juntos depois de saber as idades, quantas crianças são e como é o espaço."
        as="h1"
      />

      <div class="grid grid-4 mt-lg">
        {activities.map((a, i) => (
          <ActivityCard activity={a.data} lang={lang} delay={i * 90} />
        ))}
      </div>

      <div class="card mt-lg reveal slime-card">
        <a href="/slime" class="slime-photo" aria-label="Ver a atividade de slime">
          <Image src={slimeImage} alt="Slime roxo decorado com flores, corações e doces coloridos" widths={[360, 640]} sizes="(max-width: 700px) 100vw, 320px" />
        </a>
        <div class="slime-copy center">
          <p class="eyebrow eyebrow-teal mb-sm">Nova atividade</p>
          <h2 class="h3 mb-sm">Slime com o Ted</h2>
          <p style="color:var(--ink-soft);font-size:.96rem">Mistura, cores e muita diversão.</p>
          <a href="/slime" class="btn btn-teal mt-md">Ver os vídeos de slime</a>
        </div>
      </div>

      <div class="card mt-lg reveal extra-card">
        <div class="extra-photo">
          <Image src={photo("baloes-modelaveis.jpg")} alt="Ted a criar balões modeláveis com uma criança" widths={[360, 640]} sizes="(max-width: 700px) 100vw, 320px" loading="lazy" />
        </div>
        <div class="extra-copy center">
          <p class="eyebrow eyebrow-teal mb-sm">Para completar a festa</p>
          <h2 class="h3 mb-sm">Balões e bolhas</h2>
          <p style="color:var(--ink-soft);font-size:.96rem">Escolhemos os extras que combinam com o grupo.</p>
        </div>
      </div>
    </div>
    <Wave fill="#F0E4C4" variant={2} />
  </section>

  <CtaBand lang={lang} context="uma festa com estas atividades" />
</Base>

<style>
  .slime-card { display:grid; grid-template-columns:320px 1fr; max-width:760px; margin:3rem auto 0; overflow:hidden; background:#F5E7FF; }
  .slime-photo { display:block; min-height:360px; }
  .slime-photo :global(img) { width:100%; height:100%; display:block; object-fit:cover; }
  .slime-copy { align-self:center; padding:2rem; }
  .extra-card { display:grid; grid-template-columns:320px 1fr; max-width:760px; margin:3rem auto 0; overflow:hidden; }
  .extra-photo :global(img) { width:100%; height:100%; min-height:360px; display:block; object-fit:cover; }
  .extra-copy { align-self:center; padding:2rem; }
  @media (max-width:700px) {
    .slime-card, .extra-card { grid-template-columns:1fr; }
    .slime-photo { min-height:0; }
    .slime-photo :global(img) { height:auto; }
    .extra-photo :global(img) { min-height:0; height:auto; }
  }
</style>
