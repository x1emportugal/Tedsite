---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import Deco from "../components/Deco.astro";
import { NAV, whatsappUrl } from "../lib/site";

const lang = "pt" as const;
---

<Base
  title="Página não encontrada | Ted Animações"
  description="A página que procura não existe."
  lang={lang}
  path="/404"
  noindex
>
  <section class="section bg-cream" style="padding-top:9rem;min-height:70vh;display:grid;place-items:center">
    <Deco shape="circle" color="#F5C842" size={90} class="animate-float-slow" style="top:18%;right:12%;opacity:.5" />
    <Deco shape="star" color="#2D7A6E" class="animate-spin-slow" style="width:55px;bottom:20%;left:10%;opacity:.35" />

    <div class="container center" style="max-width:620px">
      <p class="eyebrow mx-auto mb-md">
        <Icon name="map" size={14} color="#1A2E2A" /> Página não encontrada
      </p>
      <h1 class="h1 mb-md">Esta pista não leva a lado nenhum</h1>
      <p class="lede mx-auto mb-lg">
        O endereço que seguiu não existe ou mudou de sítio. As caças ao tesouro
        que organizo correm melhor do que esta, prometo.
      </p>

      <div class="row gap-md" style="justify-content:center">
        <a href="/" class="btn btn-teal">Voltar ao início</a>
        <a href={whatsappUrl()} class="btn btn-whatsapp" target="_blank" rel="noopener" data-cta="404">
          <Icon name="whatsapp" size={20} /> Falar comigo
        </a>
      </div>

      <div class="mt-lg" style="margin-top:2.5rem">
        <p style="font-size:.85rem;color:var(--ink-muted);margin-bottom:.7rem">Ou siga por aqui:</p>
        <div class="row gap-md" style="justify-content:center">
          {NAV.pt.map((l) => (
            <a href={l.href} class="nav-link" style="font-size:.9rem">{l.label}</a>
          ))}
        </div>
      </div>
    </div>
  </section>
</Base>
