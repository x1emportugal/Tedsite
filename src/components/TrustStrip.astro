---
import Icon from "./Icon.astro";
import type { Lang } from "../lib/site";

/**
 * Bloco de confiança. Responde à pergunta que trava a decisão dos pais:
 * "posso confiar nesta pessoa com o meu filho?".
 * Nenhum concorrente do Algarve comunica isto com clareza.
 */
interface Props { lang: Lang }
const { lang } = Astro.props;
const en = lang === "en";

const items = en
  ? [
      { icon: "shield", title: "Insured", text: "PLEASE CONFIRM: public liability insurance details" },
      { icon: "file", title: "Documentation in order", text: "PLEASE CONFIRM: criminal record certificate, tax number" },
      { icon: "palette", title: "Skin-safe materials", text: "Hypoallergenic, water-based paints certified for children" },
      { icon: "users", title: "Never leaves the group", text: "Children are supervised for the whole session, start to finish" },
    ]
  : [
      { icon: "shield", title: "Seguro de responsabilidade civil", text: "PREENCHER: dados concretos do seguro" },
      { icon: "file", title: "Documentação em dia", text: "PREENCHER: registo criminal, NIF e situação fiscal" },
      { icon: "palette", title: "Materiais seguros para a pele", text: "Tintas hipoalergénicas de base aquosa, certificadas para crianças" },
      { icon: "users", title: "O grupo nunca fica sozinho", text: "Acompanhamento permanente do início ao fim da animação" },
    ];
---

<div class="trust-strip reveal">
  {items.map((it) => (
    <div class="trust-item">
      <Icon name={it.icon} size={22} color="#F5C842" />
      <div>
        <h3>{it.title}</h3>
        <p>{it.text}</p>
      </div>
    </div>
  ))}
</div>
