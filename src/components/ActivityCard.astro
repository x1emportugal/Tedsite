---
import { Image } from "astro:assets";
import Icon from "./Icon.astro";
import { photo } from "../lib/images";
import type { Lang } from "../lib/site";

interface Props {
  activity: {
    slug: string;
    title: string;
    summary: string;
    icon: string;
    color: string;
    image: string;
    imageAlt: string;
    ages: string;
    duration: string;
  };
  lang: Lang;
  delay?: number;
}
const { activity: a, lang, delay = 0 } = Astro.props;
const href = lang === "en" ? `/en/activities/${a.slug}` : `/atividades/${a.slug}`;
// Ícone claro sobre fundo escuro, escuro sobre fundo claro.
const iconColor = a.color === "#F5C842" || a.color === "#7BC67E" ? "#1A2E2A" : "#FAF0DC";
---

<article class="card card-hover activity-card reveal" style={`transition-delay:${delay}ms`}>
  <a href={href} style="text-decoration:none;color:inherit;display:flex;flex-direction:column;height:100%">
    <div class="media">
      <Image
        src={photo(a.image)}
        alt={a.imageAlt}
        widths={[320, 480, 640]}
        sizes="(min-width: 1024px) 300px, (min-width: 640px) 45vw, 90vw"
        loading="lazy"
      />
      <span class="badge-icon" style={`background:${a.color}`}>
        <Icon name={a.icon} size={22} color={iconColor} />
      </span>
    </div>
    <div class="card-body">
      <h3>{a.title}</h3>
      <p>{a.summary}</p>
      <p style="font-size:.82rem;color:var(--ink-muted);margin-top:.7rem">
        {a.ages} · {a.duration}
      </p>
      <span class="card-link">
        {lang === "en" ? "See how it works" : "Ver como funciona"}
        <Icon name="arrow-right" size={15} color="#2D7A6E" />
      </span>
    </div>
  </a>
</article>
