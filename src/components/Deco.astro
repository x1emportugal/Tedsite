---
/**
 * Formas orgânicas decorativas, a assinatura visual da marca.
 * Puramente decorativas: aria-hidden e fora do fluxo de leitura.
 */
interface Props {
  shape: "wiggle" | "circle" | "blob" | "star" | "dots";
  color?: string;
  size?: number;
  style?: string;
  class?: string;
}
const { shape, color = "#2D7A6E", size = 60, style, class: cls = "" } = Astro.props;
const klass = `organic-deco ${cls}`;
---

{shape === "wiggle" && (
  <svg viewBox="0 0 320 80" fill="none" class={klass} style={style} aria-hidden="true">
    <path d="M10 60 C60 10, 120 80, 180 40 S280 10, 310 50" stroke={color} stroke-width="10" stroke-linecap="round" fill="none"/>
  </svg>
)}

{shape === "circle" && (
  <svg width={size} height={size} viewBox="0 0 60 60" class={klass} style={style} aria-hidden="true">
    <circle cx="30" cy="30" r="30" fill={color}/>
  </svg>
)}

{shape === "blob" && (
  <svg viewBox="0 0 200 200" class={klass} style={style} aria-hidden="true">
    <path fill={color} d="M42.7,-62.9C54.9,-53.7,63.7,-40.2,68.4,-25.4C73.1,-10.6,73.7,5.5,68.2,19.1C62.7,32.7,51.1,43.8,38.1,52.2C25.1,60.6,10.7,66.3,-4.2,68.1C-19.1,69.9,-34.4,67.8,-45.8,59.5C-57.2,51.2,-64.7,36.7,-68.2,21.1C-71.7,5.5,-71.2,-11.2,-64.5,-24.7C-57.8,-38.2,-44.9,-48.5,-31.5,-57.2C-18.1,-65.9,-4.2,-73,9.8,-72.6C23.8,-72.2,30.5,-72.1,42.7,-62.9Z" transform="translate(100 100)"/>
  </svg>
)}

{shape === "star" && (
  <svg viewBox="0 0 100 100" class={klass} style={style} aria-hidden="true">
    <path fill={color} d="M50 5 L61 35 L95 35 L68 57 L79 91 L50 70 L21 91 L32 57 L5 35 L39 35 Z"/>
  </svg>
)}

{shape === "dots" && (
  <svg viewBox="0 0 80 80" class={klass} style={style} aria-hidden="true">
    {[0, 1, 2, 3].map((row) =>
      [0, 1, 2, 3].map((col) => (
        <circle cx={10 + col * 20} cy={10 + row * 20} r="4" fill={color} opacity="0.3"/>
      )),
    )}
  </svg>
)}
