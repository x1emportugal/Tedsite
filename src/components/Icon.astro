---
/**
 * Conjunto de ícones SVG inline, portado do site original.
 * Inline (em vez de sprite externo) porque são poucos e evita um pedido.
 */
interface Props {
  name: string;
  size?: number;
  color?: string;
  class?: string;
}
const { name, size = 24, color = "currentColor", class: cls } = Astro.props;

// Ícones de traço partilham os mesmos atributos.
const stroke = {
  fill: "none",
  stroke: color,
  "stroke-width": "2",
  "stroke-linecap": "round" as const,
  "stroke-linejoin": "round" as const,
};
