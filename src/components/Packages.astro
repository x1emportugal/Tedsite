---
import Icon from "./Icon.astro";
import { whatsappUrl, type Lang } from "../lib/site";

interface Pkg {
  id: string;
  name: string;
  forWho: string;
  price: number | null;
  priceNote: string;
  duration: string;
  entertainers: number;
  workshops: number;
  activities: number;
  includes: string[];
  featured: boolean;
}
interface Props {
  packages: Pkg[];
  lang: Lang;
}
const { packages, lang } = Astro.props;
const en = lang === "en";
---

<div class="price-grid">
  {packages.map((p) => (
    <article class:list={["price-card", "reveal", p.featured && "featured"]}>
      {p.featured && (
        <span class="price-flag">{en ? "Most requested" : "O mais pedido"}</span>
      )}
      <h3 class="price-name">{p.name}</h3>
      <p class="price-for">{p.forWho}</p>

      {/*
        Sem tabela de preços por decisão do Ted: cada festa é diferente e o
        valor depende da duração, do número de crianças e da distância.
        O destaque passa a ser a duração e o que está incluído.
      */}
      <p class="price-value" style="font-size:1.35rem">{p.duration}</p>
      <p class="price-unit">
        {en ? "all materials included" : "todo o material incluído"}
      </p>

      <div class="package-facts" aria-label={en ? "Package summary" : "Resumo do pacote"}>
        <span><strong>{p.entertainers}</strong> {en ? "entertainers" : "animadores"}</span>
        <span><strong>{p.workshops}</strong> {p.workshops === 1 ? "workshop" : "workshops"}</span>
        <span><strong>{p.activities}</strong> {en ? (p.activities === 1 ? "activity" : "activities") : (p.activities === 1 ? "atividade" : "atividades")}</span>
      </div>

      <ul class="price-list">
        {p.includes.map((item) => (
          <li>
            <Icon name="check" size={16} color="#2D7A6E" />
            <span>{item}</span>
          </li>
        ))}
      </ul>

      <a
        href={whatsappUrl(
          en ? `the ${p.name} package` : `o pacote ${p.name}`,
          lang,
        )}
        class:list={["btn", p.featured ? "btn-whatsapp" : "btn-outline", "btn-block"]}
        target="_blank"
        rel="noopener"
        data-cta={`pacote-${p.id}`}
      >
        {p.featured && <Icon name="whatsapp" size={18} />}
        {en ? "Check availability" : "Ver disponibilidade"}
      </a>
    </article>
  ))}
</div>

<style>
  .package-facts {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: .45rem;
    margin: 1rem 0 1.25rem;
  }
  .package-facts span {
    padding: .65rem .35rem;
    border-radius: .8rem;
    background: var(--cream-deep);
    color: var(--ink-soft);
    font-size: .76rem;
    line-height: 1.2;
    text-align: center;
  }
  .package-facts strong { display: block; color: var(--ink); font-size: 1.05rem; }
</style>
