---
import { Image } from "astro:assets";
import { photo, GALLERY } from "../lib/images";
import type { Lang } from "../lib/site";

interface Props {
  lang: Lang;
  limit?: number;
}
const { lang, limit } = Astro.props;
const items = limit ? GALLERY.slice(0, limit) : GALLERY;
const en = lang === "en";
---

<div class="gallery-grid reveal">
  {items.map((g, i) => (
    <figure class:list={["gallery-item", i === 0 && "wide", g.portrait && "portrait"]}>
      <Image
        src={photo(g.file)}
        alt={en ? g.altEn : g.alt}
        widths={[400, 700, 1000]}
        sizes="(min-width: 1024px) 33vw, (min-width: 640px) 48vw, 92vw"
        loading="lazy"
      />
    </figure>
  ))}
</div>

<style>
  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
    gap: 1rem;
  }
  .gallery-item {
    margin: 0;
    border-radius: var(--r-lg);
    overflow: hidden;
    aspect-ratio: 4 / 3;
    box-shadow: var(--shadow-sm);
  }
  .gallery-item :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }
  .gallery-item:hover :global(img) { transform: scale(1.04); }
  .gallery-item.portrait { aspect-ratio: 9 / 16; }

  @media (min-width: 900px) {
    .gallery-grid { grid-template-columns: repeat(4, 1fr); }
    .gallery-item.wide { grid-column: span 2; grid-row: span 2; aspect-ratio: 1 / 1; }
    .gallery-item.portrait { grid-row: span 2; }
  }
</style>
