---
import { Font } from "astro:assets";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import WhatsAppFloat from "../components/WhatsAppFloat.astro";
import { SITE, absoluteUrl, altLanguageUrls, T, type Lang } from "../lib/site";
import { businessSchema, websiteSchema, webPageSchema, breadcrumbSchema } from "../lib/schema";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  lang?: Lang;
  /** Caminho canónico desta página, começado por "/". */
  path: string;
  /** Imagem para partilha social (caminho absoluto ou URL). */
  ogImage?: string;
  /** Blocos JSON-LD adicionais desta página. */
  schemas?: (object | null)[];
  /** Migalhas de navegação: também geram BreadcrumbList. */
  breadcrumbs?: { name: string; href: string }[];
  /** Impedir indexação (usado no 404 e na política de privacidade). */
  noindex?: boolean;
}

const {
  title,
  description,
  lang = "pt",
  path,
  ogImage,
  schemas = [],
  breadcrumbs,
  noindex = false,
} = Astro.props;

const canonical = absoluteUrl(path);
const alt = altLanguageUrls(path);
const og = ogImage ?? absoluteUrl("/ted-preview.png");
const t = T[lang];

// Analytics por variável de ambiente: sem elas, nenhum script é incluído.
const analyticsSrc = import.meta.env.PUBLIC_ANALYTICS_SRC;
const analyticsId = import.meta.env.PUBLIC_ANALYTICS_ID;

// Blocos de dados estruturados: o negócio vai em todas as páginas,
// mais a página em si, as migalhas e o que a página acrescentar.
const jsonLd = [
  businessSchema(),
  websiteSchema(),
  webPageSchema({ title, description, url: path, lang }),
  breadcrumbs ? breadcrumbSchema(breadcrumbs) : null,
  ...schemas,
].filter(Boolean);
---

<!doctype html>
<html lang={lang === "en" ? "en-GB" : "pt-PT"}>
  <head>
    <meta charset="utf-8" />
    <!-- Sem maximum-scale: bloquear o zoom é uma violação de acessibilidade. -->
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <!--
      Alternativas de idioma. Só declaradas quando a página equivalente
      existe mesmo: um hreflang a apontar para uma URL inexistente faz o
      Google descartar o par de idiomas por inteiro.
    -->
    {alt.pt && <link rel="alternate" hreflang="pt-PT" href={alt.pt} />}
    {alt.en && <link rel="alternate" hreflang="en-GB" href={alt.en} />}
    {alt.pt && <link rel="alternate" hreflang="x-default" href={alt.pt} />}

    <!-- Open Graph / partilhas -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="600" />
    <meta property="og:image:height" content="600" />
    <meta property="og:locale" content={lang === "en" ? "en_GB" : "pt_PT"} />
    <meta property="og:locale:alternate" content={lang === "en" ? "pt_PT" : "en_GB"} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={og} />

    <link rel="icon" href="/ted-felt-logo.png" type="image/png" />
    <link rel="apple-touch-icon" href="/ted-felt-logo.png" />
    <meta name="theme-color" content="#2D7A6E" />

    <!-- Fontes self-hosted: sem pedido bloqueante a fonts.googleapis.com -->
    <Font cssVariable="--font-display" preload />
    <Font cssVariable="--font-body" preload />

    {jsonLd.map((s) => (
      <script type="application/ld+json" set:html={JSON.stringify(s)} is:inline />
    ))}

    {/*
      Analytics. Só é incluído se as duas variáveis estiverem definidas, o
      que evita um <script> partido em desenvolvimento. O Umami não usa
      cookies, por isso não é preciso banner de consentimento.

      No Vercel, em Settings → Environment Variables:
        PUBLIC_ANALYTICS_SRC  = https://<o-seu-umami>/script.js
        PUBLIC_ANALYTICS_ID   = 029f71b8-a41a-4282-9708-2b9014148ac4
    */}
    {analyticsSrc && analyticsId && (
      <script
        is:inline
        defer
        src={analyticsSrc}
        data-website-id={analyticsId}
        data-domains="tedinportugal.pt"
      />
    )}

    <script is:inline>
      // Ativa o estado escondido das revelações ANTES da primeira pintura, e
      // só se o IntersectionObserver existir para as voltar a mostrar. Sem
      // isto, o conteúdo fica simplesmente visível, que é o comportamento
      // seguro. Uma rede de segurança revela tudo passado 2,5 s, caso o
      // observer não chegue a disparar (separador em segundo plano, etc.).
      if ("IntersectionObserver" in window) {
        document.documentElement.classList.add("js-reveal");
        setTimeout(function () {
          document.documentElement.classList.remove("js-reveal");
        }, 2500);
      }
    </script>
  </head>

  <body>
    <a class="skip-link" href="#conteudo">{t.skip}</a>
    <Nav lang={lang} path={path} />

    <main id="conteudo">
      <slot />
    </main>

    <Footer lang={lang} />
    <WhatsAppFloat lang={lang} />

    <script>
      // Revelação ao scroll. Melhoria progressiva: o conteúdo já está no
      // HTML e é visível sem JS. Isto só acrescenta o movimento.
      const els = document.querySelectorAll<HTMLElement>(".reveal");
      if (els.length && "IntersectionObserver" in window) {
        const obs = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add("is-visible");
                obs.unobserve(e.target);
              }
            }
          },
          // Sem threshold: basta 1px visível. Secções altas nunca chegam a
          // 10% do próprio tamanho dentro do ecrã e ficariam escondidas.
          { rootMargin: "0px 0px -40px 0px" },
        );
        els.forEach((el) => obs.observe(el));
      } else {
        els.forEach((el) => el.classList.add("is-visible"));
      }

      // Barra de navegação: fundo sólido depois do scroll.
      const nav = document.querySelector(".nav");
      if (nav) {
        const onScroll = () =>
          nav.setAttribute("data-scrolled", String(window.scrollY > 40));
        onScroll();
        window.addEventListener("scroll", onScroll, { passive: true });

        const toggle = nav.querySelector(".nav-toggle");
        toggle?.addEventListener("click", () => {
          const open = nav.getAttribute("data-open") === "true";
          nav.setAttribute("data-open", String(!open));
          toggle.setAttribute("aria-expanded", String(!open));
        });
      }

      // Medir conversões. Sem isto não se sabe o que funciona: a auditoria
      // encontrou o Umami instalado mas sem um único evento.
      document.addEventListener("click", (ev) => {
        const link = (ev.target as HTMLElement)?.closest?.("a[href*='wa.me']");
        if (!link) return;
        const where = link.getAttribute("data-cta") || "desconhecido";
        // @ts-ignore, umami é opcional
        window.umami?.track?.("whatsapp-click", { origem: where });
      });
    </script>
  </body>
</html>
