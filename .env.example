# Copiar para .env e preencher. No Vercel, definir em Settings → Environment Variables.

# Analytics (Umami). Sem estas duas, nenhum script de analytics é carregado.
PUBLIC_ANALYTICS_SRC=https://o-seu-umami.exemplo/script.js
PUBLIC_ANALYTICS_ID=029f71b8-a41a-4282-9708-2b9014148ac4

# Formulário de orçamento. Sem isto, o formulário abre o WhatsApp com a
# mensagem composta em vez de enviar por email.
PUBLIC_FORM_ENDPOINT=https://formspree.io/f/xxxxxxx
